{
  "name": "finance-person",
  "version": "1.0.0",
  "description": "Finance Person - Personal finance dashboard (SaaS, RBAC, MongoDB Atlas)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "nodemon --watch server server/app.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/app.js",
    "seed": "node server/config/seed.js",
    "test": "node scripts/test-api.mjs",
    "test:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-jwt": "^8.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "morgan": "^1.10.0",
    "mongodb": "^6.12.0",
    "sweetalert2": "^11.15.10",
    "toastify-js": "^1.12.0",
    "uuid": "^9.0.1",
    "validator": "^13.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.7",
    "vite": "^5.4.11"
  }
}
