# Copia este archivo como .env y completa los valores reales.
# El archivo .env está en .gitignore: NUNCA versionar credenciales.

PORT=4000
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-unico

# MongoDB Atlas — cluster M0 "Cluster0", base finance_person.
# Se usa la cadena ESTÁNDAR (hosts explícitos) porque el SRV (mongodb+srv://)
# devolvió ECONNREFUSED en el entorno de desarrollo.
# Si la contraseña tiene caracteres especiales, codifícalos en la URL
# (por ejemplo: ! -> %21, @ -> %40, # -> %23).
MONGODB_URI=mongodb://<USUARIO>:<PASSWORD>@ac-yxrmadt-shard-00-00.k3xzdbh.mongodb.net:27017,ac-yxrmadt-shard-00-01.k3xzdbh.mongodb.net:27017,ac-yxrmadt-shard-00-02.k3xzdbh.mongodb.net:27017/?ssl=true&authSource=admin&replicaSet=atlas-2uo7u3-shard-0&retryWrites=true&w=majority
MONGODB_DB=finance_person
MONGODB_TEST_DB=finance_person_test
